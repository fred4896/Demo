{
  "name": "TNG QR Share Demo",
  "short_name": "TNG QR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1726",
  "theme_color": "#0d6efd",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-handler",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "qr", "accept": ["image/png", "image/jpeg", "image/webp"] }]
    }
  }
}
